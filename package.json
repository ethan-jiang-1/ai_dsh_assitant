{
  "name": "ai-dsh-assistant",
  "version": "0.0.0",
  "private": true,
  "description": "Dev root for the dsh-smart-assistant plugin: an agent preset whose home (memory, skills, curation) is engineered, not accidental.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dsh": "node scripts/dsh.mjs",
    "gen-paths": "node scripts/gen-paths.mjs",
    "gen-catalog": "node scripts/gen-catalog.mjs",
    "usage": "node dev/usage-report.mjs",
    "import-knowledge": "TSX_TSCONFIG_PATH=tsconfig.tsx.json node --import tsx/esm scripts/import-knowledge.mjs",
    "expert-setup": "TSX_TSCONFIG_PATH=tsconfig.tsx.json node --import tsx/esm scripts/expert-setup.mjs",
    "eval": "node dev/eval/run.mjs",
    "eval:domain": "node dev/eval/domain-run.mjs",
    "ov-trial-rt": "node dev/ov-rt.mjs",
    "typecheck": "pnpm --filter dsh-smart-assistant run typecheck",
    "build": "pnpm --filter dsh-smart-assistant run build",
    "test": "pnpm --filter dsh-smart-assistant run test",
    "verify": "node scripts/gen-paths.mjs --check && node scripts/gen-catalog.mjs --check && node dev/eval/run.mjs --self-check && node dev/desk-loop-report.mjs --self-check && node dev/eval/domain-run.mjs --self-check && node scripts/verify.mjs",
    "release-smoke": "node scripts/release-smoke.mjs",
    "export-dist": "node scripts/export-dist.mjs",
    "preflight": "node scripts/webui-preflight.mjs",
    "shots": "node scripts/webui-shots.mjs",
    "loop-probe": "node scripts/webui-loop-probe.mjs",
    "desk-loop": "node dev/desk-loop-report.mjs",
    "sync-dsh": "node scripts/sync-dsh.mjs",
    "repair-vendor": "TSX_TSCONFIG_PATH=tsconfig.tsx.json node --import tsx/esm scripts/repair-vendor-artifacts.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
