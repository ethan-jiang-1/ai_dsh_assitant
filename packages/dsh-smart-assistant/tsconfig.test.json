{
  // 测试的类型面：把 tests/ 也纳入检查，但不发射产物。
  // 测试可以 import 任意 src（含宿主面服务），所以这里**不走 base 的 paths**（那会把 vendor
  // 源码拉进本工程：rootDir 冲突 + 外部源码在本仓严格标志下误报）。`paths: {}` 整体覆盖
  // 继承值，让 @deepseek-ai/* 经 node_modules（workspace 链接）解析到 vendor 的**构建声明**
  // （lib/types），配合 base 的 skipLibCheck 只查本仓代码。vendor 源码面的 API 漂移仍由
  // 根 `pnpm typecheck`（tsc -b 项目引用）负责；type-only 的 vendor 依赖按 vendor 规则
  // 声明在 devDependencies。
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "rootDir": ".",
    "paths": {}
  },
  "include": [
    "src",
    "tests"
  ]
}
