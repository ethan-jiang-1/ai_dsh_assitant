{
  "name": "dsh-smart-assistant",
  "version": "0.1.12",
  "private": true,
  "description": "A DSH agent preset that owns a home: durable memory, self-written skills, and machine-checked curation.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethan-jiang-1/ai_dsh_assitant.git",
    "directory": "packages/dsh-smart-assistant"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": {
    "ov-doctor": "./bin/ov-doctor.mjs",
    "expert-setup": "./bin/expert-setup.mjs",
    "assistant-data": "./bin/assistant-data.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tool-memory": {
      "types": "./lib/agent/tool-memory/index.d.ts",
      "default": "./lib/agent/tool-memory/index.js"
    },
    "./tool-recall": {
      "types": "./lib/agent/tool-recall/index.d.ts",
      "default": "./lib/agent/tool-recall/index.js"
    },
    "./tool-research": {
      "types": "./lib/agent/tool-research/index.d.ts",
      "default": "./lib/agent/tool-research/index.js"
    },
    "./tool-knowledge": {
      "types": "./lib/agent/tool-knowledge/index.d.ts",
      "default": "./lib/agent/tool-knowledge/index.js"
    },
    "./memory-digest": {
      "types": "./lib/agent/memory-digest/index.d.ts",
      "default": "./lib/agent/memory-digest/index.js"
    },
    "./home-preamble": {
      "types": "./lib/agent/home-preamble/index.d.ts",
      "default": "./lib/agent/home-preamble/index.js"
    },
    "./learn": {
      "types": "./lib/agent/learn/index.d.ts",
      "default": "./lib/agent/learn/index.js"
    },
    "./knowledge-approve-remote": {
      "types": "./lib/host/knowledge-approve-remote/index.d.ts",
      "default": "./lib/host/knowledge-approve-remote/index.js"
    },
    "./desk-projection": {
      "types": "./lib/host/desk-projection/index.d.ts",
      "default": "./lib/host/desk-projection/index.js"
    },
    "./ui-mode": {
      "types": "./lib/host/ui-mode/index.d.ts",
      "default": "./lib/host/ui-mode/index.js"
    },
    "./viki": {
      "types": "./lib/host/viki/index.d.ts",
      "default": "./lib/host/viki/index.js"
    },
    "./rooms-route": {
      "types": "./lib/host/rooms-route/index.d.ts",
      "default": "./lib/host/rooms-route/index.js"
    },
    "./operating-ledger": {
      "types": "./lib/host/operating-ledger/index.d.ts",
      "default": "./lib/host/operating-ledger/index.js"
    },
    "./tool-operating": {
      "types": "./lib/agent/tool-operating/index.d.ts",
      "default": "./lib/agent/tool-operating/index.js"
    },
    "./preset-runner": {
      "types": "./lib/dev/preset-runner/index.d.ts",
      "default": "./lib/dev/preset-runner/index.js"
    },
    "./ov-shield": {
      "types": "./lib/agent/ov-shield/index.d.ts",
      "default": "./lib/agent/ov-shield/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./package.json": "./package.json",
    "./operating-brief": {
      "types": "./lib/agent/operating-brief/index.d.ts",
      "default": "./lib/agent/operating-brief/index.js"
    }
  },
  "files": [
    "lib",
    "bin",
    "presets",
    "seeds",
    "bootstrap.mjs",
    "LICENSE",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf lib tsconfig.tsbuildinfo",
    "build": "tsc -b tsconfig.json && tsdown",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-agent-preset": "workspace:^",
    "@deepseek-ai/dsh-brand": "workspace:^",
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-schedule": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-skill": "workspace:^",
    "@deepseek-ai/dsh-skill-filesystem": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-typert-protocol": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-agent-default-model": "workspace:^",
    "@deepseek-ai/dsh-agent-loop": "workspace:^",
    "@deepseek-ai/dsh-agent-preset": "workspace:^",
    "@deepseek-ai/dsh-agent-preset-registry": "workspace:^",
    "@deepseek-ai/dsh-brand": "workspace:^",
    "@deepseek-ai/dsh-client-connection": "workspace:^",
    "@deepseek-ai/dsh-client-store": "workspace:^",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-goal": "workspace:^",
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-host-webserver": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-schedule": "workspace:^",
    "@deepseek-ai/dsh-scope": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-session-persistence-jsonl": "workspace:^",
    "@deepseek-ai/dsh-session-projection": "workspace:^",
    "@deepseek-ai/dsh-skill": "workspace:^",
    "@deepseek-ai/dsh-skill-filesystem": "workspace:^",
    "@deepseek-ai/dsh-system-prompt": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-typert-protocol": "workspace:^",
    "@deepseek-ai/dsh-typert-registry": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "js-yaml": "^4.3.2",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "semver": "^7.8.5"
  }
}
